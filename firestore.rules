rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Public catalog (read-only for everyone) ─────────────────────────────
    match /stories/{storyId} {
      allow read: if true;
      allow write: if false;
    }

    match /featured/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ── User-scoped data (only the owner can read/write their own subtree) ──
    match /users/{uid} {
      allow read, create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;

      match /favorites/{storyId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /history/{storyId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /myStories/{storyId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /notifications/{notifId} {
        allow read, update: if request.auth != null && request.auth.uid == uid;
        // Notifications are written by Cloud Functions / admin only.
        allow create, delete: if false;
      }
      match /settings/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
